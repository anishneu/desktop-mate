{
  "name": "desktop-mate",
  "version": "0.1.0",
  "description": "Animated anime/Live2D desktop companion that wanders, climbs screen edges, reacts to the cursor and runs small tasks.",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "snapshot": "electron . --snapshot=snapshot.png",
    "test": "node --test test/",
    "dist": "electron-builder --win --publish never"
  },
  "build": {
    "appId": "com.anishkuila.desktopmate",
    "productName": "Desktop Mate",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  },
  "author": "Anish Kuila",
  "license": "MIT",
  "dependencies": {
    "pixi-live2d-display": "^0.4.0",
    "pixi.js": "^6.5.10"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  }
}
